# Contact form (app/api/contact/route.ts) — create a key at https://resend.com
# Until BOTH are set, the form returns a clear "not set up" message and the page shows a mailto fallback.
# Note: the default sender is Resend's sandbox (onboarding@resend.dev), which only delivers to the
# Resend account owner's own verified email. Set CONTACT_TO to that address, or verify a domain in Resend.
RESEND_API_KEY=
CONTACT_TO=

# Public site origin, used for canonical URLs, the sitemap, robots and the social share image.
# Set this to the real production domain before launch, e.g. https://thophan.example
NEXT_PUBLIC_SITE_URL=
